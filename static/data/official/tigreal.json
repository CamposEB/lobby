{"v":1,"source":"Moonton (mobilelegends.com)","patch":"2.2.16","updated":"2026-10-08","hero":{"name":"Tigreal","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8b30576754be1a4f8bebd09df8d6bec7.png","head_big":"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_ec2ad5967a2d8a0ac5e2cef2a1e24411.jpg","square":"https://akmweb.youngjoygame.com/web/svnres/file/test/homepage_2_2_16_1232_1/100_a9d93ed3dd0d1385f25372eda0aa10e7.jpg","squarebig":"https://akmweb.youngjoygame.com/web/svnres/file/test/homepage_2_2_16_1232_1/100_ec2ad5967a2d8a0ac5e2cef2a1e24411.jpg","smallmap":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4e0005dbfb1376beaccc54ef7aa39375.png","wallpaper":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_2f346943d85318a466b5eba513682d7c.png","hero_id":6,"wallpaper_source":"painting"},"stats":{"win":44.54,"pick":1.85,"ban":5.58},"compat":{"metric":"pp","best":[{"hero":"Angela","value":3.0},{"hero":"Zilong","value":2.9},{"hero":"Floryn","value":2.9},{"hero":"Aldous","value":2.7},{"hero":"Natalia","value":2.5}],"worst":[{"hero":"Grock","value":-7.1},{"hero":"Johnson","value":-5.0},{"hero":"Franco","value":-5.0},{"hero":"Marcel","value":-4.7},{"hero":"Kalea","value":-4.4}]},"lore":{"short":"Leader of the Light's Order, guardian of the Moniyan Empire.","long":null},"meta":{"difficulty":"10","speciality":["Crowd Control"],"roadsort":["Roaming"],"sort":["Tank"],"recommend":"3-1-2","sorticon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e746915cd7826d1d334dc5f4cb5e34a1.png","roadicon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_abb6e4a5579bbffa22c9184584e5f155.png"},"skills":[{"id":640,"name":"Fearless","description":"Tigreal gains 1 stack of Fearless each time he is hit by a Basic Attack. At 4 stacks, he consumes them to block the next incoming Basic Attack (including attacks from Turrets).\nHe also gains 1 stack of Fearless each time he casts a skill.\n\nDamage from minions does not add or consume Fearless stacks.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_5b028ce65e323d962d7060705f59743f.png","video":null,"cd":null,"cost":null,"is_passive":true,"tags":[{"name":"Buff","rgb":"79,156,184"}]},{"id":610,"name":"Attack Wave","description":"Tigreal smashes the ground with his hammer, sending a shockwave that erupts 3 times in a fan-shaped area. Each eruption deals 270 (+70% Total Physical Attack) Physical Damage to enemies hit and slows them by 20% / 40% / 60% for 1.5s.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8e00063700ab16f53d840986b98aae25.png","video":null,"cd":7.0,"cost":45.0,"is_passive":false,"tags":[{"name":"AOE","rgb":"199,121,85"},{"name":"Slow","rgb":"205,93,109"}]},{"id":620,"name":"Sacred Hammer","description":"Tigreal charges in the target direction, dealing  (+100% Total Physical Attack) Physical Damage to enemies along the way and pushing them to the end of the charge.\n\nUse Again: Tigreal can use this skill again within 4s, dealing 280 (+60% Total Physical Attack) Physical Damage to enemies in front of him and knocking them airborne for 0.6s.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png","video":null,"cd":16.0,"cost":70.0,"is_passive":false,"tags":[{"name":"Charge","rgb":"162,105,198"},{"name":"CC","rgb":"205,93,109"}]},{"id":630,"name":"Implosion","description":"Tigreal unleashes the power of his hammer, pulling nearby enemies to him, dealing 600 (+130% Total Physical Attack) Physical Damage and stunning them for 1.8s.\n\nThe first half of the channeling can be interrupted by control effects, while the second half can only be interrupted by Suppression.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_46e5c2b6f8fd6fda995a63d5c10f19e5.png","video":null,"cd":55.0,"cost":120.0,"is_passive":false,"tags":[{"name":"CC","rgb":"205,93,109"},{"name":"AOE","rgb":"199,121,85"}]}],"counters":{"assist":{"desc":"Tigreal works well with heroes with strong initiation skills, that gives him a better chance to hit the enemies with his CC skills, such as Vexana and Odette.","heroes":[{"id":38,"name":"Vexana","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_743edd1702084c4ed247908d698bca77.png"},{"id":46,"name":"Odette","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d9251718a8894546ba04cfa9ca68dedc.png"}]},"strong":{"desc":"Tigreal's Passive can negate enemy Basic Attacks, making him strong against heroes that deal damage with their Basic Attacks, such as Zilong and Freya.","heroes":[{"id":16,"name":"Zilong","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9db57da4f0daef6d432676e4f19101ed.png"},{"id":22,"name":"Freya","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b9c34c88762ca8e66ccd4d84071bf0bc.png"}]},"weak":{"desc":"But as a melee hero, Tigreal is countered by Ranged Mage heroes like Chang'e and Zhask.","heroes":[{"id":61,"name":"Chang'e","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_46cfe9c30e8a14f85b4d022496aca274.png"},{"id":50,"name":"Zhask","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d8f170087cb2d5b71bb22a0a4664a927.png"}]}},"official_url":"https://play.mobilelegends.com/lore/hero/Tigreal","skins":[{"name":"Wyrmslayer","name_slug":"Wyrmslayer","image":"https://esportpedia.b-cdn.net/mlbbhub/skins/tigreal/Tigreal-Wyrmslayer-20201128042856.webp","image_filename":"Tigreal-Wyrmslayer-20201128042856.webp","released":"2020-11-28","is_original":true},{"name":"Warrior Of Dawn","name_slug":"Warrior-of-Dawn","image":"https://esportpedia.b-cdn.net/mlbbhub/skins/tigreal/Tigrea