akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f48a1786aeb1572d0309f509ddd0b444.png","video":null,"cd":null,"cost":null,"is_passive":true,"tags":[{"name":"Buff","rgb":"79,156,184"}]},{"id":5810,"name":"Asura Aura","description":"Martis draws enemies to a fan-shaped area in front of him and deals 350 (+130% Extra Physical Attack) Physical Damage, slowing them by 40% for 2s.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dec679229c3d8b5f18144acfc2cda27f.png","video":null,"cd":7.0,"cost":null,"is_passive":false,"tags":[{"name":"CC","rgb":"205,93,109"},{"name":"AOE","rgb":"199,121,85"}]},{"id":5820,"name":"Mortal Coil","description":"Martis strikes in the target direction three times, each time dealing 225 (+120% Extra Physical Attack) Physical Damage to enemies hit. Enemies hit by the first and third strike are also knocked back. The attack direction can be changed once using the Joystick.\n\nUse Again: Martis leaps in the target direction, dealing 300 (+150% Extra Physical Attack) Physical Damage to enemies in his path and knocking them airborne.\nMartis gains Control Immunity and 60% Damage Reduction when casting this skill.","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_910d3e465d051726ab223b215b7cfdb5.png","video":null,"cd":8.0,"cost":null,"is_passive":false,"tags":[{"name":"Mobility","rgb":"162,105,198"},{"name":"AOE","rgb":"199,121,85"}]},{"id":5830,"name":"Decimation","description":"Martis lunges at a designated enemy hero, dealing 700 (+120% Total Physical Attack) Physical Damage (deals True Damage if the enemy's HP is below 50%).\nIf the enemy is killed by this skill, Martis can cast the skill again within 10s and gains 100% extra Movement Speed that gradually decays over 5s. Each successive cast also increases the skill's damage by 15% (up to 30%).","icon":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bbdf118fe86a5279e943a6db86fc4d7a.png","video":null,"cd":36.0,"cost":null,"is_passive":false,"tags":[{"name":"Burst","rgb":"199,121,85"},{"name":"Buff","rgb":"79,156,184"}]}],"counters":{"assist":{"desc":"Martis works best with Fighters that initiate teamfights like Alpha and Khaleed who he can follow up to secure a kill and chain more kills with his Ultimate.","heroes":[{"id":28,"name":"Alpha","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_86c9f91f530727db6498f920d19180d1.png"},{"id":98,"name":"Khaleed","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_540a6a9d343842674ce002082366ec9d.png"}]},"strong":{"desc":"Martis counters squishy heroes with no mobility skills, such as Layla and Odette, who have a hard time avoiding his 1st Skill - 2nd Skill combo. Their relatively low HP also makes it easier for Martis to put them into execute range for his Ultimate.\n","heroes":[{"id":18,"name":"Layla","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b2b38e9406ea0de0b866db7674feea0f.png"},{"id":46,"name":"Odette","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d9251718a8894546ba04cfa9ca68dedc.png"}]},"weak":{"desc":"Martis is countered by Fighters with high combat sustainability, such as Thamuz and Fredrinn, because they can survive Martis' burst damage and defeat him in prolonged battles.","heroes":[{"id":72,"name":"Thamuz","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b5ad55e408b68acf6a86e7ff76f5f569.png"},{"id":117,"name":"Fredrinn","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dea170bfd5f26c41fb04e5edf72afedb.png"}]}},"skins":[{"name":"God Of War","name_slug":"God-of-War","image":"https://esportpedia.b-cdn.net/mlbbhub/skins/martis/Martis-God-of-War-20220804115103.webp","image_filename":"Martis-God-of-War-20220804115103.webp","released":"2022-08-04","is_original