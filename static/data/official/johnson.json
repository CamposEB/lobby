s/img/test/homepage_2_2_16_1232_1/100_3b552855efed5343debb078d885c15f8.png","video":null,"cd":36.0,"cost":null,"is_passive":false,"tags":[{"name":"Morph","rgb":"97,127,198"},{"name":"CC","rgb":"205,93,109"}]}],"counters":{"assist":{"desc":"Johnson works well with heroes that need help initiating like Odette and Kadita since they can just jump into Johnson's Ultimate for a ride.","heroes":[{"id":46,"name":"Odette","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d9251718a8894546ba04cfa9ca68dedc.png"},{"id":75,"name":"Kadita","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_99c0a77d0e01b06ad3f4351f8ef2869c.png"}]},"strong":{"desc":"Johnson counters melee heroes with high burst like Alucard and Zilong\nbecause of Johnson's high Physical Defense and CC ability.","heroes":[{"id":7,"name":"Alucard","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_0f51b6906e08897aa02330d65b0deeac.png"},{"id":16,"name":"Zilong","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9db57da4f0daef6d432676e4f19101ed.png"}]},"weak":{"desc":"Johnson is countered by agile heroes who deal Magic Damage such as Harith and Kagura because they can easily dodge Johnson's skills while their damage is not affected by his Physical Defense.","heroes":[{"id":73,"name":"Harith","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d228a823b477fdf6c458c829c2e62bcf.png"},{"id":25,"name":"Kagura","head":"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_da424b020b8ac8235d64a1b8a09aa749.png"}]}},"official_url":"https://play.mobilelegends.com/lore/hero/Johnson","skins":[{"name":"Jeepney Racer","name_slug":"Jeepney-Racer","image":"https://esportpedia.b-cdn.net/mlbbhub/skins/johnson/Johnson-Jeepney-Racer-20181031101759.webp","image_filename":"Johnson-Jeepney-Racer-20181031101759.webp","released":"2018-10-31","